rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // JUEGOS ACTUALES — SIN CAMBIOS
    // =====================================================

    match /game_teams/{teamId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasAll([
          'gameId',
          'classCode',
          'teamName',
          'score',
          'round'
        ]);

      allow update: if
        request.resource.data.gameId == resource.data.gameId
        && request.resource.data.classCode == resource.data.classCode
        && request.resource.data.teamName == resource.data.teamName;

      allow delete: if false;
    }

    match /game_decisions/{decisionId} {
      allow read: if true;

      allow create, update: if
        request.resource.data.keys().hasAll([
          'gameId',
          'classCode',
          'teamName',
          'round'
        ]);

      allow delete: if false;
    }

    // =====================================================
    // SATURNO — SIN CAMBIOS
    // =====================================================

    match /saturno_control/{documentId} {
      allow read, create, update, delete: if true;
    }

    match /saturno_sessions/{sessionId} {
      allow read, create, update, delete: if true;

      match /participants/{participantId} {
        allow read, create, update, delete: if true;
      }
    }

    // =====================================================
    // KNOWLEDGE CHALLENGE — QUIZ GC — SIN CAMBIOS
    // =====================================================

    match /gc_quiz_live/{roomId} {
      allow read, create, update, delete: if true;

      match /players/{playerId} {
        allow read, create, update, delete: if true;
      }

      // Full identity is not copied to the publicly readable player/ranking documents.
      // identities/{playerId}: name (0..30 chars; required for "both"),
      // cedula (1..30 digits, string preserves leading zeros), identityType.
      match /identities/{playerId} {
        function quizFacilitator() {
          return request.auth != null && request.auth.token.facilitator == true;
        }
        function validQuizIdentity() {
          let data = request.resource.data;
          let run = getAfter(/databases/$(database)/documents/gc_quiz_live/$(roomId)).data;
          let player = getAfter(/databases/$(database)/documents/gc_quiz_live/$(roomId)/players/$(playerId)).data;
          return data.keys().hasAll(['name', 'cedula', 'identityType'])
            && data.keys().hasOnly(['name', 'cedula', 'identityType'])
            && data.identityType in ['cedula', 'both']
            && data.name is string && data.name.size() <= 30
            && (data.identityType == 'both'
              ? data.name.size() > 0 && data.name == player.name
              : data.name == '')
            && data.cedula is string && data.cedula.matches('^[0-9]{1,30}$')
            && player.identityType == data.identityType
            && run.recordType == 'run' && run.participantIdentity == data.identityType
            && run.get('deleting', false) == false;
        }
        // Participants can submit the data they supplied, without being able to read or list it.
        allow create: if validQuizIdentity();
        // Re-entry is idempotent; an existing identity cannot be overwritten.
        allow update: if validQuizIdentity() && request.resource.data == resource.data;
        allow read, delete: if quizFacilitator();
      }
    }

    // =====================================================
    // EL FLACO — ECOSISTEMA DE APRENDIZAJE — SIN CAMBIOS
    // =====================================================

    match /el_flaco_rooms/{roomCode} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;

      match /teams/{teamId} {
        allow read: if true;
        allow create, update, delete: if true;
      }
    }

    // =====================================================
    // KNOWLEDGE CHALLENGE — BANCOS — SIN CAMBIOS
    // =====================================================

    match /gc_quiz_banks/{bankId} {
      allow read, create, update, delete: if true;
    }

    // =====================================================
    // LAS REGLAS DEL JUEGO — NUEVO PORTAL
    // =====================================================

    function reglasSigned() {
  return request.auth != null;
}

function reglasHost(room) {
  return reglasSigned()
    && get(/databases/$(database)/documents/reglas_salas/$(room)).data.host == request.auth.uid;
}

match /reglas_salas/{room} {
  allow create: if reglasSigned()
    && request.resource.data.host == request.auth.uid;
  allow read: if reglasSigned();
  allow update, delete: if reglasSigned()
    && resource.data.host == request.auth.uid;

  match /participants/{id} {
    allow read: if reglasSigned();
    allow create: if reglasSigned()
      && id == request.auth.uid
      && request.resource.data.uid == request.auth.uid;
    allow update: if reglasSigned()
      && (id == request.auth.uid || reglasHost(room));
    allow delete: if reglasHost(room);
  }

  match /pairs/{id} {
    allow read: if reglasSigned();
    allow create, delete: if reglasHost(room);
    allow update: if reglasSigned() && (
      reglasHost(room) ||
      (resource.data.proposer == request.auth.uid
        && resource.data.offer == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer'])
        && request.resource.data.offer is int
        && request.resource.data.offer >= 0
        && request.resource.data.offer <= 100) ||
      (resource.data.receiver == request.auth.uid
        && resource.data.offer is int
        && resource.data.accepted == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepted'])
        && request.resource.data.accepted is bool)
    );
  }

  match /teams/{id} {
    allow read: if reglasSigned();
    allow create: if reglasSigned()
      && id == request.auth.uid
      && request.resource.data.owner == request.auth.uid;
    allow update: if reglasSigned() && (
      reglasHost(room) ||
      (id == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.policyScore == resource.data.policyScore
        && (
          (get(/databases/$(database)/documents/reglas_salas/$(room)).data.phase == 'r1'
            && resource.data.lockedR1 == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['strategies', 'lockedR1'])
            && request.resource.data.lockedR1 == true
            && request.resource.data.strategies is list)
          ||
          (get(/databases/$(database)/documents/reglas_salas/$(room)).data.phase == 'r2'
            && resource.data.lockedR2 == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actions', 'policy', 'lockedR2'])
            && request.resource.data.lockedR2 == true
            && request.resource.data.actions is list
            && request.resource.data.policy is list
            && request.resource.data.policy.size() == 5)
        ))
    );
    allow delete: if reglasHost(room);
  }
}
    // =====================================================
    // ADAPTA LAB — AUTOTEST DE ADAPTABILIDAD
    // =====================================================

    match /rooms/{roomId} {
      allow read, create, update: if true;
      allow delete: if false;

      match /submissions/{studentId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }

    // =====================================================
    // TALENTO & RIESGO LAB — SALAS, EQUIPOS Y RANKING
    // =====================================================

    function talentoFacilitator() {
      return request.auth != null && request.auth.token.facilitator == true;
    }
    
    function talentoHost(roomCode) {
      return talentoFacilitator()
        && exists(/databases/$(database)/documents/talento_lab_rooms/$(roomCode))
        && get(/databases/$(database)/documents/talento_lab_rooms/$(roomCode)).data.hostUid == request.auth.uid;
    }
    
    function talentoLobby(roomCode) {
      return exists(/databases/$(database)/documents/talento_lab_rooms/$(roomCode))
        && get(/databases/$(database)/documents/talento_lab_rooms/$(roomCode)).data.phase == 'lobby';
    }
    
    function talentoPlaying(roomCode) {
      return exists(/databases/$(database)/documents/talento_lab_rooms/$(roomCode))
        && get(/databases/$(database)/documents/talento_lab_rooms/$(roomCode)).data.phase == 'playing';
    }
    
    // El límite de respuesta se evalúa con hora del servidor, nunca con el reloj del equipo.
function talentoTimeOpen(roomCode) {
  let state = get(/databases/$(database)/documents/talento_lab_rooms/$(roomCode)).data;
  // Salas creadas antes de V2.2 conservan compatibilidad hasta su próxima ronda.
  return !state.keys().hasAll(['roundStartedAt', 'roundDurationSec'])
    || (state.roundStartedAt is timestamp
      && state.roundDurationSec is int
      && state.roundDurationSec >= 60
      && state.roundDurationSec <= 480
      && request.time < state.roundStartedAt + duration.value(state.roundDurationSec, 's'));
}

match /talento_lab_rooms/{roomCode} {
      // Código de sala conocido, autenticación anónima para los participantes.
      allow get: if request.auth != null;
      allow list: if talentoFacilitator();
    
      allow create: if talentoFacilitator()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.gameId == 'talento-riesgo-v2'
        && request.resource.data.phase == 'lobby'
        && request.resource.data.round == -1;
    
      allow update: if talentoHost(roomCode)
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.gameId == resource.data.gameId;
      allow delete: if talentoHost(roomCode);
    
      match /teams/{teamId} {
        // Ranking por sala: únicamente nombres inventados de equipos, nada sensible.
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/talento_lab_rooms/$(roomCode));
    
        allow create: if request.auth != null
          && teamId == request.auth.uid
          && talentoLobby(roomCode)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 40
          && request.resource.data.score == 0
          && request.resource.data.budget == 100
          && request.resource.data.submittedRound == -1
          && request.resource.data.choice == -1
          && request.resource.data.legalChoice == -1
          && request.resource.data.history == []
          && request.resource.data.effects == []
          && request.resource.data.stats == {
            'cap': 45,
            'trust': 55,
            'fair': 55,
            'ops': 65,
            'risk': 15
          };
    
        // El facilitador es el único que liquida puntajes y consecuencias.
        // El participante solo puede enviar UNA opción por ronda.
        allow update: if talentoHost(roomCode)
          || (request.auth != null
          && teamId == request.auth.uid
          && resource.data.ownerUid == request.auth.uid
          && talentoPlaying(roomCode)
      && talentoTimeOpen(roomCode)
          && resource.data.submittedRound != get(/databases/$(database)/documents/talento_lab_rooms/$(roomCode)).data.round
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'choice', 'legalChoice', 'submittedRound', 'submittedAt'
          ])
          && request.resource.data.submittedRound == get(/databases/$(database)/documents/talento_lab_rooms/$(roomCode)).data.round
          && request.resource.data.choice is int
          && request.resource.data.choice >= 0
          && request.resource.data.choice <= 2
          && request.resource.data.legalChoice is int
          && request.resource.data.legalChoice >= 0
          && request.resource.data.legalChoice <= 2);
    
        allow delete: if talentoHost(roomCode);
      }
    }

    // =====================================================
    // RADAR DE CULTURA DE EQUIPOS — CVF ADAPTADO
    // =====================================================
// RADAR DE CULTURA DE EQUIPOS (CVF) — añadir dentro de match /databases/{database}/documents.
// Adaptación educativa independiente. El rol facilitator se asigna con Firebase Admin SDK.

function cvfIsFacilitator() {
  return request.auth != null && request.auth.token.facilitator == true;
}
function cvfRoom(roomCode) {
  return get(/databases/$(database)/documents/ocai_rooms/$(roomCode)).data;
}
function cvfIsHost(roomCode) {
  return cvfIsFacilitator()
    && exists(/databases/$(database)/documents/ocai_rooms/$(roomCode))
    && cvfRoom(roomCode).hostUid == request.auth.uid;
}
function cvfRoomOpen(roomCode) {
  return exists(/databases/$(database)/documents/ocai_rooms/$(roomCode))
    && cvfRoom(roomCode).status == 'open';
}
function cvfRow(row) {
  // Minimo coste de evaluacion por fila para 12 distribuciones.
  // Operaciones numericas fallan ante valores no numericos.
  // No se permiten puntos negativos, y la suma de 100 limita el maximo.
  return row is map
    && row.keys().hasOnly(['a','b','c','d'])
    && row.a >= 0 && row.b >= 0
    && row.c >= 0 && row.d >= 0
    && row.a + row.b + row.c + row.d == 100;
}
function cvfSixDimensions(rows) {
  return rows is list && rows.size() == 6
    && cvfRow(rows[0]) && cvfRow(rows[1]) && cvfRow(rows[2])
    && cvfRow(rows[3]) && cvfRow(rows[4]) && cvfRow(rows[5]);
}
match /ocai_rooms/{roomCode} {
  // Participantes conocen el código de su sala; no pueden enumerar salas.
  allow get: if request.auth != null;
  allow list: if cvfIsFacilitator();
  allow create: if cvfIsFacilitator()
    && request.resource.data.keys().hasOnly([
      'gameId','hostUid','className','teams','status','createdAt','updatedAt'
    ])
    && request.resource.data.hostUid == request.auth.uid
    && request.resource.data.gameId == 'culture-cvf-team-v1'
    && request.resource.data.status == 'open'
    && request.resource.data.className is string
    && request.resource.data.className.size() >= 4
    && request.resource.data.className.size() <= 75
    && request.resource.data.teams is list
    && request.resource.data.teams.size() >= 1
    && request.resource.data.teams.size() <= 20;
  allow update: if cvfIsHost(roomCode)
    && request.resource.data.hostUid == resource.data.hostUid
    && request.resource.data.gameId == resource.data.gameId
    && request.resource.data.teams == resource.data.teams
    && request.resource.data.className == resource.data.className
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
    && request.resource.data.status in ['open','closed'];
  allow delete: if false;

  match /responses/{participantId} {
    // Respuestas individuales: solo su autor y el facilitador pueden leerlas.
    allow get: if request.auth != null
      && (participantId == request.auth.uid || cvfIsHost(roomCode));
    // La consulta agregada solo puede realizarla el facilitador.
    allow list: if cvfIsHost(roomCode);
    allow create: if request.auth != null
      && participantId == request.auth.uid
      && cvfRoomOpen(roomCode)
      && request.resource.data.keys().hasOnly([
        'uid','team','version','current','preferred','submittedAt'
      ])
      && request.resource.data.keys().hasAll([
        'uid','team','version','current','preferred','submittedAt'
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.team is string
      && request.resource.data.team in cvfRoom(roomCode).teams
      && request.resource.data.version == 1
      && cvfSixDimensions(request.resource.data.current)
      && cvfSixDimensions(request.resource.data.preferred)
      && request.resource.data.submittedAt == request.time;
    // Una sola respuesta por identidad anónima; no permitir modificar respuestas.
    allow update, delete: if false;
  }
  match /summary/{documentId} {
    // Solo se expone el agregado publicado, nunca respuestas individuales.
    allow get: if request.auth != null && documentId == 'public'
      && resource.data.overall.n >= 3;
    allow list: if false;
    allow create, update: if documentId == 'public'
      && cvfIsHost(roomCode)
      && request.resource.data.keys().hasOnly([
        'version','groups','overall','publishedAt'
      ])
      && request.resource.data.version == 1
      && request.resource.data.groups is list
      && request.resource.data.overall is map
      && request.resource.data.overall.n is int
      && request.resource.data.overall.n >= 3;
    allow delete: if false;
  }
}

    // =====================================================
    // NEXUS — SALAS, EQUIPOS PRIVADOS, RETIROS Y REINICIO
    // =====================================================
    function nexusFacilitator() {
      return request.auth != null && request.auth.token.facilitator == true;
    }
    function nexusRoom(code) {
      return get(/databases/$(database)/documents/nexus_rooms/$(code)).data;
    }
    function nexusHost(code) {
      return nexusFacilitator()
        && nexusRoom(code).hostUid == request.auth.uid;
    }
    function nexusEpoch(code) {
      return nexusRoom(code).get('resetEpoch', 0);
    }
    function nexusAllowedTeam(code, teamId) {
      return !exists(/databases/$(database)/documents/nexus_rooms/$(code)/removed/$(teamId))
        || get(/databases/$(database)/documents/nexus_rooms/$(code)/removed/$(teamId)).data.resetEpoch != nexusEpoch(code);
    }
    match /nexus_rooms/{roomCode} {
      allow get: if request.auth != null;
      allow list: if nexusFacilitator() && resource.data.hostUid == request.auth.uid;
      allow create: if nexusFacilitator()
        && request.resource.data.gameId == 'nexus-v1'
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.classCode == roomCode
        && request.resource.data.status == 'open'
        && request.resource.data.mode in ['guided','autonomous']
        && request.resource.data.currentRound == 1
        && request.resource.data.phase in ['waiting','deciding']
        && request.resource.data.resetEpoch == 0;
      allow update: if nexusHost(roomCode)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','mode','currentRound','phase','resetEpoch','updatedAt'
        ])
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.classCode == resource.data.classCode
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.mode in ['guided','autonomous']
        && request.resource.data.currentRound is int
        && request.resource.data.currentRound >= 1
        && request.resource.data.currentRound <= 5
        && request.resource.data.phase in ['waiting','deciding','discussion']
        && request.resource.data.status in ['open','resetting','completed']
        && request.resource.data.get('resetEpoch',0) is int
        && (
          (resource.data.status == 'open'
            && request.resource.data.status in ['open','completed','resetting']
            && request.resource.data.get('resetEpoch',0) == resource.data.get('resetEpoch',0))
          || (resource.data.status == 'completed'
            && request.resource.data.status == 'resetting'
            && request.resource.data.get('resetEpoch',0) == resource.data.get('resetEpoch',0))
          || (resource.data.status == 'resetting'
            && request.resource.data.status == 'open'
            && request.resource.data.currentRound == 1
            && request.resource.data.phase ==
              (request.resource.data.mode == 'guided' ? 'waiting' : 'deciding')
            && request.resource.data.get('resetEpoch',0) == resource.data.get('resetEpoch',0) + 1)
        );
      allow delete: if false;

      match /removed/{teamId} {
        allow get: if request.auth != null
          && (request.auth.uid == teamId || nexusHost(roomCode));
        allow list: if nexusHost(roomCode);
        allow create, update: if nexusHost(roomCode)
          && request.resource.data.keys().hasOnly([
            'ownerUid','team','resetEpoch','removedAt'
          ])
          && request.resource.data.ownerUid == teamId
          && request.resource.data.team is string
          && request.resource.data.team.size() <= 35
          && request.resource.data.resetEpoch == nexusEpoch(roomCode)
          && request.resource.data.removedAt == request.time;
        allow delete: if nexusHost(roomCode);
      }

      match /teams/{teamId} {
        allow get: if request.auth != null
          && (request.auth.uid == teamId || nexusHost(roomCode));
        allow list: if nexusHost(roomCode);
        allow create: if request.auth != null
          && request.auth.uid == teamId
          && nexusRoom(roomCode).status == 'open'
          && nexusAllowedTeam(roomCode,teamId)
          && request.resource.data.ownerUid == teamId
          && request.resource.data.resetEpoch == nexusEpoch(roomCode)
          && request.resource.data.team is string
          && request.resource.data.team.size() >= 2
          && request.resource.data.team.size() <= 35
          && request.resource.data.gameState is map
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100;
        allow update: if request.auth != null
          && request.auth.uid == teamId
          && nexusRoom(roomCode).status == 'open'
          && nexusAllowedTeam(roomCode,teamId)
          && resource.data.ownerUid == teamId
          && request.resource.data.ownerUid == teamId
          && request.resource.data.team == resource.data.team
          && request.resource.data.resetEpoch == nexusEpoch(roomCode)
          && request.resource.data.round >= resource.data.round
          && request.resource.data.borrowed >= resource.data.borrowed
          && request.resource.data.spent >= resource.data.spent
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100;
        allow delete: if nexusHost(roomCode);
      }

      match /ranking/{teamId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == teamId
          && nexusRoom(roomCode).status == 'open'
          && nexusAllowedTeam(roomCode,teamId)
          && request.resource.data.ownerUid == teamId
          && request.resource.data.resetEpoch == nexusEpoch(roomCode)
          && request.resource.data.keys().hasOnly([
            'ownerUid','team','resetEpoch','score','round','borrowed','updatedAt'
          ])
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100
          && request.resource.data.score == getAfter(
            /databases/$(database)/documents/nexus_rooms/$(roomCode)/teams/$(teamId)
          ).data.score
          && request.resource.data.borrowed == getAfter(
            /databases/$(database)/documents/nexus_rooms/$(roomCode)/teams/$(teamId)
          ).data.borrowed;
        allow delete: if nexusHost(roomCode);
      }
    }


    // =====================================================
    // LA LEY Y LA CULTURA — SIMULACIÓN CONDUCTUAL INDEPENDIENTE
    // =====================================================
    function lcSigned() {
      return request.auth != null;
    }
    function lcFacilitator() {
      return lcSigned() && request.auth.token.facilitator == true;
    }
    function lcRoom(code) {
      return get(/databases/$(database)/documents/ley_cultura_rooms/$(code)).data;
    }
    function lcHost(code) {
      return lcFacilitator()
        && exists(/databases/$(database)/documents/ley_cultura_rooms/$(code))
        && lcRoom(code).hostUid == request.auth.uid
        && lcRoom(code).organizationId ==
          (request.auth.token.get('organizationId', request.auth.uid));
    }
    function lcLiveWrite(code, round) {
      return lcSigned()
        && exists(/databases/$(database)/documents/ley_cultura_rooms/$(code))
        && lcRoom(code).status == 'active'
        && lcRoom(code).phase == 'write'
        && lcRoom(code).round == round;
    }
    function lcAnswerId(id, participantUid, round) {
      return (round == 1 && id == participantUid + '_1')
        || (round == 2 && id == participantUid + '_2')
        || (round == 3 && id == participantUid + '_3')
        || (round == 4 && id == participantUid + '_4');
    }
    function lcValidAnswer(round, answer) {
      return answer is map
        && ((round == 1
          && answer.keys().hasOnly(['choice', 'microtask'])
          && answer.choice in ['continue', 'later']
          && answer.microtask is string
          && answer.microtask.size() <= 280
          && ((answer.choice == 'continue' && answer.microtask == '') || (answer.choice == 'later' && answer.microtask.size() >= 10)))
        || (round == 2
          && answer.keys().hasOnly(['choice', 'microtask'])
          && answer.choice in ['inform', 'resolve', 'hold']
          && answer.microtask == '')
        || (round in [3, 4]
          && answer.keys().hasOnly(['words', 'text', 'initial'])
          && answer.words is list && answer.words.size() == 4
          && answer.words[0] is string && answer.words[1] is string
          && answer.words[2] is string && answer.words[3] is string
          && answer.text is string && answer.text.size() >= 12
          && answer.text.size() <= 200
          && answer.initial is string && answer.initial.size() <= 200));
    }
    function lcParticipantAnswer(code, answerId) {
      return lcSigned()
        && request.resource.data.keys().hasOnly([
          'uid','round','answer','durationMs','revision',
          'reopenToken','createdAt','submittedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.round is int
        && lcAnswerId(answerId, request.auth.uid, request.resource.data.round)
        && lcLiveWrite(code, request.resource.data.round)
        && exists(/databases/$(database)/documents/ley_cultura_rooms/$(code)/assignments/$(request.auth.uid))
        && request.resource.data.durationMs is number
        && request.resource.data.durationMs >= 0
        && request.resource.data.durationMs <= 7200000
        && request.resource.data.reopenToken ==
          (lcRoom(code).reopenRound == request.resource.data.round
            ? lcRoom(code).reopenToken : 0)
        && lcValidAnswer(request.resource.data.round, request.resource.data.answer)
        && request.resource.data.submittedAt == request.time;
    }
    match /ley_cultura_rooms/{roomCode} {
      // Al conocer el código de la sala se puede consultar el estado, no los resultados.
      allow get: if lcSigned();
      // Las consultas de historial deben limitarse por hostUid.
      allow list: if lcFacilitator() && resource.data.hostUid == request.auth.uid;
      allow create: if lcFacilitator()
        && request.resource.data.keys().hasOnly([
          'gameId','hostUid','organizationId','title','status','round','phase',
          'createdAt','updatedAt','reopenRound','reopenToken'
        ])
        && request.resource.data.gameId == 'ley-cultura-v1'
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.organizationId == request.auth.token.get('organizationId', request.auth.uid)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 75
        && request.resource.data.status == 'waiting'
        && request.resource.data.round == 1
        && request.resource.data.phase == 'write'
        && request.resource.data.reopenRound == 0
        && request.resource.data.reopenToken == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if lcHost(roomCode)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','round','phase','updatedAt','reopenRound','reopenToken'
        ])
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.title == resource.data.title
        && request.resource.data.status in ['waiting','active','paused','completed']
        && request.resource.data.round in [1,2,3,4]
        && request.resource.data.phase in ['write','review']
        && request.resource.data.reopenRound in [0,1,2,3,4]
        && request.resource.data.reopenToken is int
        && request.resource.data.reopenToken >= resource.data.reopenToken
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      match /participants/{participantId} {
        allow get: if lcHost(roomCode) || (lcSigned() && participantId == request.auth.uid);
        allow list: if lcHost(roomCode);
        allow create: if lcSigned() && participantId == request.auth.uid
          && lcRoom(roomCode).status != 'completed'
          && request.resource.data.keys().hasOnly(['uid','name','joinedAt','lastSeenAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 55
          && request.resource.data.joinedAt == request.time
          && request.resource.data.lastSeenAt == request.time;
        allow update: if lcSigned() && participantId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
          && request.resource.data.lastSeenAt == request.time;
        allow delete: if false;
      }
      match /assignments/{participantId} {
        allow get: if lcHost(roomCode) || (lcSigned() && participantId == request.auth.uid);
        allow list: if lcHost(roomCode);
        allow create: if lcHost(roomCode)
          && exists(/databases/$(database)/documents/ley_cultura_rooms/$(roomCode)/participants/$(participantId))
          && request.resource.data.keys().hasOnly(['uid','condition','assignedAt'])
          && request.resource.data.uid == participantId
          && request.resource.data.condition in ['A','B']
          && request.resource.data.assignedAt == request.time;
        allow update, delete: if false;
      }
      match /responses/{answerId} {
        allow get: if lcHost(roomCode)
          || (lcSigned() && lcAnswerId(answerId, request.auth.uid, 1))
          || (lcSigned() && lcAnswerId(answerId, request.auth.uid, 2))
          || (lcSigned() && lcAnswerId(answerId, request.auth.uid, 3))
          || (lcSigned() && lcAnswerId(answerId, request.auth.uid, 4));
        allow list: if lcHost(roomCode);
        allow create: if lcParticipantAnswer(roomCode,answerId)
          && request.resource.data.revision == 1
          && request.resource.data.createdAt == request.time;
        allow update: if lcParticipantAnswer(roomCode,answerId)
          && resource.data.uid == request.auth.uid
          && resource.data.round == request.resource.data.round
          && request.resource.data.revision == resource.data.revision + 1
          && lcRoom(roomCode).reopenRound == resource.data.round
          && resource.data.reopenToken < lcRoom(roomCode).reopenToken
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
      match /response_events/{eventId} {
        allow get, list: if lcHost(roomCode);
        allow create: if lcSigned()
          && request.resource.data.keys().hasOnly([
            'uid','answerId','round','answer','durationMs','revision','recordedAt'
          ])
          && eventId.matches('^' + request.auth.uid + '_[1-4]_[0-9]+_[0-9]+$')
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.answerId is string
          && lcAnswerId(request.resource.data.answerId, request.auth.uid, request.resource.data.round)
          && lcLiveWrite(roomCode, request.resource.data.round)
          && request.resource.data.recordedAt == request.time
          && getAfter(/databases/$(database)/documents/ley_cultura_rooms/$(roomCode)/responses/$(request.resource.data.answerId)).data.answer == request.resource.data.answer;
        allow update, delete: if false;
      }
      match /peer_assignments/{participantId} {
        allow get: if lcHost(roomCode) || (lcSigned() && participantId == request.auth.uid);
        allow list: if lcHost(roomCode);
        allow create, update: if lcHost(roomCode)
          && request.resource.data.keys().hasOnly(['recipientUid','sourceUid','message','assignedAt'])
          && request.resource.data.recipientUid == participantId
          && request.resource.data.sourceUid != participantId
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 12
          && request.resource.data.message.size() <= 200
          && request.resource.data.assignedAt == request.time;
        allow delete: if false;
      }
      match /perceptions/{participantId} {
        allow get: if lcHost(roomCode) || (lcSigned() && participantId == request.auth.uid);
        allow list: if lcHost(roomCode);
        allow create: if lcSigned() && participantId == request.auth.uid
          && lcRoom(roomCode).status == 'active'
          && lcRoom(roomCode).round == 4
          && lcRoom(roomCode).phase == 'review'
          && exists(/databases/$(database)/documents/ley_cultura_rooms/$(roomCode)/peer_assignments/$(participantId))
          && request.resource.data.keys().hasOnly(['uid','sourceUid','perception','durationMs','submittedAt'])
          && request.resource.data.uid == participantId
          && request.resource.data.sourceUid == get(/databases/$(database)/documents/ley_cultura_rooms/$(roomCode)/peer_assignments/$(participantId)).data.sourceUid
          && request.resource.data.perception in ['trust','uncertainty','pressure']
          && request.resource.data.durationMs is number
          && request.resource.data.durationMs >= 0
          && request.resource.data.submittedAt == request.time;
        allow update, delete: if false;
      }
    }

    // =====================================================
    // EL BOTÓN ROJO — SALAS Y RESPUESTAS INMUTABLES
    // =====================================================
    function brSigned() {
      return request.auth != null;
    }
    function brFacilitator() {
      return brSigned() && request.auth.token.facilitator == true;
    }
    function brExists(roomCode) {
      return exists(/databases/$(database)/documents/boton_rojo_rooms/$(roomCode));
    }
    function brRoom(roomCode) {
      return get(/databases/$(database)/documents/boton_rojo_rooms/$(roomCode)).data;
    }
    function brHost(roomCode) {
      return brFacilitator() && brExists(roomCode)
        && brRoom(roomCode).hostUid == request.auth.uid
        && brRoom(roomCode).organizationId ==
          request.auth.token.get('organizationId', request.auth.uid);
    }
    function brMember(roomCode) {
      return brSigned() && exists(
        /databases/$(database)/documents/boton_rojo_rooms/$(roomCode)/participants/$(request.auth.uid)
      );
    }
    function brValidAnswerId(answerId, d) {
      return answerId == d.uid + '_' + string(d.round) + '_' + d.stage + '_' + string(d.token);
    }
    match /boton_rojo_rooms/{roomCode} {
      // El código de sala solo permite leer instrucciones/estado, no resultados.
      allow get: if brSigned();
      allow list: if brFacilitator() && resource.data.hostUid == request.auth.uid;
      allow create: if brFacilitator()
        && roomCode.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly([
          'gameId','hostUid','organizationId','title','status','round','phase',
          'token','createdAt','updatedAt','openedAt'
        ])
        && request.resource.data.gameId == 'boton-rojo-v1'
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.organizationId ==
          request.auth.token.get('organizationId', request.auth.uid)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 75
        && request.resource.data.status == 'waiting'
        && request.resource.data.phase == 'initial'
        && request.resource.data.round == 1
        && request.resource.data.token == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.openedAt == request.time;
      allow update: if brHost(roomCode)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','round','phase','token','updatedAt','openedAt'
        ])
        && request.resource.data.status in ['waiting','active','paused','completed']
        && request.resource.data.round in [1,2,3,4]
        && request.resource.data.phase in ['initial','final','review','reveal']
        && request.resource.data.token is int
        && request.resource.data.token >= 0
        && request.resource.data.token <= 100
        && request.resource.data.updatedAt == request.time
        && request.resource.data.openedAt is timestamp
        && (request.resource.data.status != 'completed' || request.resource.data.round == 4)
        && (
          (resource.data.status == 'waiting'
            && request.resource.data.status == 'active'
            && request.resource.data.round == 1
            && request.resource.data.phase == 'initial'
            && request.resource.data.token == 0)
          || (resource.data.status == 'active'
            && request.resource.data.status == 'paused'
            && request.resource.data.round == resource.data.round
            && request.resource.data.phase == resource.data.phase
            && request.resource.data.token == resource.data.token)
          || (resource.data.status == 'paused'
            && request.resource.data.status == 'active'
            && request.resource.data.round == resource.data.round
            && request.resource.data.phase == resource.data.phase
            && request.resource.data.token == resource.data.token)
          || (resource.data.status == 'active'
            && resource.data.phase == 'initial'
            && request.resource.data.status == 'active'
            && request.resource.data.phase == 'final'
            && request.resource.data.round == resource.data.round
            && request.resource.data.token == resource.data.token)
          || (resource.data.status == 'active'
            && resource.data.phase == 'final'
            && request.resource.data.status == 'active'
            && request.resource.data.phase == 'review'
            && request.resource.data.round == resource.data.round
            && request.resource.data.token == resource.data.token)
          || (resource.data.status == 'active'
            && resource.data.phase == 'review'
            && request.resource.data.status == 'active'
            && request.resource.data.phase == 'final'
            && request.resource.data.round == resource.data.round
            && request.resource.data.token == resource.data.token + 1)
          || (resource.data.status == 'active'
            && resource.data.phase == 'review'
            && resource.data.round < 4
            && request.resource.data.status == 'active'
            && request.resource.data.phase == 'initial'
            && request.resource.data.round == resource.data.round + 1
            && request.resource.data.token == 0)
          || (resource.data.status == 'active'
            && resource.data.phase == 'review'
            && resource.data.round == 4
            && request.resource.data.status == 'completed'
            && request.resource.data.phase == 'review'
            && request.resource.data.token == resource.data.token)
          || (resource.data.status == 'completed'
            && resource.data.phase == 'review'
            && request.resource.data.status == 'completed'
            && request.resource.data.phase == 'reveal'
            && request.resource.data.round == 4
            && request.resource.data.token == resource.data.token)
        );
      allow delete: if false;
      match /participants/{participantId} {
        allow get: if brHost(roomCode) || (brSigned() && participantId == request.auth.uid);
        allow list: if brHost(roomCode);
        allow create: if brSigned() && brExists(roomCode)
          && participantId == request.auth.uid
          && brRoom(roomCode).status in ['waiting','active','paused']
          && request.resource.data.keys().hasOnly([
            'uid','name','joinedAt','lastSeenAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 55
          && request.resource.data.joinedAt == request.time
          && request.resource.data.lastSeenAt == request.time;
        allow update: if brSigned() && participantId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
          && request.resource.data.lastSeenAt == request.time;
        allow delete: if false;
      }
      match /answers/{answerId} {
        allow get: if brHost(roomCode)
          || (brSigned() && answerId.matches('^' + request.auth.uid + '_[1-4]_(initial|final)_[0-9]+$'));
        allow list: if brHost(roomCode);
        allow create: if brMember(roomCode)
          && request.resource.data.keys().hasOnly([
            'uid','round','stage','token','choice','note','durationMs','submittedAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.round is int
          && request.resource.data.round == brRoom(roomCode).round
          && request.resource.data.stage in ['initial','final']
          && request.resource.data.stage == brRoom(roomCode).phase
          && request.resource.data.token is int
          && request.resource.data.token ==
            (request.resource.data.stage == 'initial' ? 0 : brRoom(roomCode).token)
          && brValidAnswerId(answerId,request.resource.data)
          && brRoom(roomCode).status == 'active'
          && request.resource.data.choice in ['A','B','C','D']
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 150
          && (request.resource.data.stage != 'initial' || request.resource.data.note == '')
          && request.resource.data.durationMs is number
          && request.resource.data.durationMs >= 0
          && request.resource.data.durationMs <= 3600000
          && request.resource.data.submittedAt == request.time;
        allow update, delete: if false;
      }
    }

    // =====================================================
    // TODO LO DEMÁS CONTINÚA CERRADO
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
